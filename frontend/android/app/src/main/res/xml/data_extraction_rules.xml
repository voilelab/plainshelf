<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- CapacitorStorage may contain a legacy plaintext token until migration runs. -->
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="sharedpref" path="plainshelf_secure_storage.xml" />
        <!-- Local shelves stay out of Google's cloud: no cloud sync, and a large shelf would hit the 25 MB quota. -->
        <exclude domain="file" path="local-shelves/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
        <exclude domain="sharedpref" path="plainshelf_secure_storage.xml" />
        <!-- local-shelves/ is kept: device to device, no quota; the shelf list re-adds its entries. -->
    </device-transfer>
</data-extraction-rules>
