    "jsdom": "^26.1.0",
    "license-checker": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.6"
  },
  "overrides": {
    "brace-expansion@1.1.15": "1.1.16",
    "brace-expansion@2.1.0": "2.1.2",
    "postcss": "8.5.26",
    "replace": {
      "minimatch": "3.1.5"
    },
    "sharp": "0.35.3",
    "tar": "7.5.21",
    "uuid": "11.1.1"
