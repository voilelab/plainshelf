{
  "name": "plainshelf",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check-boundaries": "node scripts/check-module-boundaries.mjs",
