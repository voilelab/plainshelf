{
  "name": "plainshelf",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "check-boundaries": "node scripts/check-module-boundaries.mjs",
    "check-exports": "node scripts/check-exports.mjs",
    "check-style-contracts": "node scripts/check-style-contracts.mjs",
    "check-licenses": "license-checker --production --excludePrivatePackages --failOn \"UNLICENSED;UNKNOWN\" && node scripts/check-font-licenses.mjs && node scripts/check-icon-licenses.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@fontsource-variable/noto-serif-tc": "5.3.0",
    "@lezer/highlight": "^1.2.4",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.2",
    "reka-ui": "~2.10.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@iconify-json/tabler": "1.2.40",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.1.1",
    "license-checker": "^25.0.1",
    "typescript": "^5.6.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "postcss": "8.5.26",
    "qs@6": "6.15.3",
    "replace": {
      "minimatch": "3.1.5"
    },
    "sharp": "0.35.5",
    "tar": "7.5.21",
    "uuid": "11.1.1"
  }
}
